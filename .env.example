# Copy to .env and fill in.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/research

# REQUIRED before Module A2 (any SEC request). SEC blocks requests without a
# descriptive User-Agent identifying who you are.
EDGAR_USER_AGENT="Your Name your@email.com"

# Optional — defaults shown.
# EMBEDDING_MODEL=google/embeddinggemma-300m
# EMBEDDING_DIM=768               # must match vector(N) in sql/schema.sql
# CHUNK_TOKENS=512
# CHUNK_OVERLAP_TOKENS=64

# EmbeddingGemma is a gated HF repo. One-time setup before the first embed run:
#   1. accept the license at huggingface.co/google/embeddinggemma-300m
#   2. huggingface-cli login      (or set HF_TOKEN)
# Not a per-request key — once cached, embedding runs offline.

# --- Not needed for Module A. Added when Modules B/C are built. ---
# ANTHROPIC_API_KEY=
# FINNHUB_API_KEY=
# TAVILY_API_KEY=
