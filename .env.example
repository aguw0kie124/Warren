# Copy to .env and fill in.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/research

# REQUIRED before Module A2 (any SEC request). SEC blocks requests without a
# descriptive User-Agent identifying who you are.
EDGAR_USER_AGENT="Your Name your@email.com"

# Optional — defaults shown.
# EMBEDDING_MODEL=google/embeddinggemma-300m
# EMBEDDING_DIM=768               # must match vector(N) in sql/schema.sql
# CHUNK_TOKENS=512
# CHUNK_OVERLAP_TOKENS=64

# EmbeddingGemma is a gated HF repo. One-time setup before the first embed run:
#   1. accept the license at huggingface.co/google/embeddinggemma-300m
#   2. huggingface-cli login      (or set HF_TOKEN)
# Not a per-request key — once cached, embedding runs offline.

# --- Module B: live data. Free tiers are enough for both. ---
# Market data, company metrics, and per-ticker news: finnhub.io/register
FINNHUB_API_KEY=
# Web search returning extracted article text: tavily.com
TAVILY_API_KEY=

# --- Module C: the agent. The only paid, per-request model in the system;
# nothing in Modules A, B, or C1's tool layer needs it. ---
ANTHROPIC_API_KEY=
# Optional. Defaults below; override only to change model or answer length.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# LLM_MAX_TOKENS=8192

# --- Module D: the API. Adds no keys — it reuses everything above. ---
# The service embeds one string at startup so the model load happens before the
# first request, and so parallel searches never race a cold embedding singleton.
# scripts/check_api.py sets this false to start a deliberately cold server for
# its concurrency case. There is no reason to change it by hand.
# API_WARM_EMBEDDINGS=true
